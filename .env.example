# Copy to .env. Everything is optional: with nothing set, the system runs fully offline
# (rule-based agent, phrasebook translation, mock rides).

# --- LLM: Nemotron via NVIDIA NIM on Nebius (any OpenAI-compatible endpoint works) ---
# Nebius Token Factory (hosted, key from https://tokenfactory.nebius.com):
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Self-hosted NIM on a Nebius GPU VM:   http://<vm-ip>:8000/v1   (see docs/nebius_nim.md)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional separate model for translation; empty = LLM_MODEL (Super was faster and more accurate than Nano in our test).
LLM_FAST_MODEL=
LLM_MAX_TOKENS=2000
# Optional text prepended to the system prompt (some models toggle reasoning this way).
LLM_SYSTEM_PREFIX=

# --- Sarvam: Indic translation + speech (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# TripOwner's own voice on calls (bulbul:v3 voices include kavya, priya, ritu, neha, rahul, aditya, shubh)
SARVAM_AGENT_SPEAKER=kavya
SARVAM_STT_MODEL=saaras:v2.5
# 1 = synthesize driver + agent lines with Bulbul so the dashboard plays audio
VOICE_TTS=0
# Max characters sent to Sarvam per day (0 = no cap); over it: phrasebook + browser voice
SARVAM_DAILY_CHARS=0

# scripted = offline phrasebook driver; pool = varied natural lines generated by Nemotron (offline);
# llm = Nemotron plays the driver live (needs LLM + Sarvam)
DRIVER_MODE=scripted

# --- Real calendar (read-only) ---
# Google Calendar: Settings -> your calendar -> Integrate calendar -> "Secret address in iCal format".
# Outlook/Apple iCal links work too, or a local .ics file path. Treat the URL like a password.
CALENDAR_ICS=
# Where you start from; one of: MG Road, Indiranagar, Koramangala, HSR Layout, Whitefield, Marathahalli, Hebbal, Jayanagar
USER_LOCATION=Indiranagar
# Your name, used in real emails and alerts
USER_NAME=
# Watch mode: re-read the calendar this often, start owning a trip this long before its booking time,
# and (optionally) switch watch mode on when the server starts.
WATCH_POLL_SEC=120
WATCH_LEAD_MIN=30
WATCH_ON_START=0

# Fall back to a bike taxi when cabs keep failing (the metro is always considered where there's a station)
ALLOW_BIKE_TAXI=0

# --- Real email (Gmail) ---
# Needs Google 2-Step Verification, then an App Password from https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_APP_PASSWORD=
# 0 = "running late" emails go only to you (safe for testing); 1 = email the real meeting attendees
EMAIL_TO_ATTENDEES=0

# --- Safety ---
# Who to alert on SOS, or when you don't answer a safety check (comma-separated). Uses the Gmail setup above.
EMERGENCY_EMAILS=
# Phone them too (Twilio, see "Real phone calls" below): E.164 numbers, comma-separated.
# On a Twilio trial each must be verified (Console -> Phone Numbers -> Verified Caller IDs).
EMERGENCY_PHONES=
# How long to wait for "Are you OK?" before alerting them
SAFETY_CHECKIN_TIMEOUT_S=60
# Real rides ("I'm in a cab"): check in if your phone's GPS stays within this radius for this long
GPS_STALL_MIN=5
GPS_STALL_RADIUS_M=60
# ...or if your phone stops sending its location for this long (phone off, page closed, no signal)
GPS_SILENT_MIN=5
# Telegram alerts: token from @BotFather; contacts press Start on your bot, then list their chat IDs
# (GET /api/telegram/chats shows them). Comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Real rides (trips from your calendar, watch mode only) ---
# sim = simulated rides
# link = at booking time, Telegram sends you Uber/Ola buttons with pickup and drop filled in; tap, confirm,
#        then press Booked / No cab so TripOwner knows (needs the Telegram setup above; no Uber account needed)
# uber = book directly through Uber for Business Guest Rides (needs API access: guests.trips scope)
RIDE_PROVIDER=sim
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ORG_UUID=
# Keep a sandbox run id while testing: no real cars are dispatched. Remove it only when you mean it.
UBER_SANDBOX_RUN_ID=
# Your phone number (E.164), so the driver can call you (and TripOwner, if you forward calls)
UBER_GUEST_PHONE=
# Preferred ride type by name, e.g. Uber Go; empty = cheapest
UBER_PRODUCT=
# --- Namma Yatri / ONDC over Beckn (RIDE_PROVIDER=beckn) ---
# Needs TripOwner registered on ONDC as a buyer app: your domain, an Ed25519 key pair (python -c
# "from tripowner.providers.beckn import new_keypair; print(new_keypair())"), whitelisting, staging tests.
# Until then, pick "Rides: Namma Yatri over Beckn (mock network)" on the dashboard to see it work.
BECKN_SUBSCRIBER_ID=
BECKN_KEY_ID=k1
BECKN_PRIVATE_KEY=
BECKN_BAP_URI=
BECKN_GATEWAY_URI=
# CAB or AUTO_RICKSHAW
BECKN_VEHICLE=CAB
BECKN_RIDER_PHONE=
# --- Real phone calls (Twilio) ---
# Forward unanswered calls to your Twilio number; TripOwner answers ("Are you the driver?") in the caller's language.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (calls come in here; emergency calls go out from it)
TWILIO_PHONE_NUMBER=
# Public https address of this server (a tunnel to your laptop), so Twilio can reach /twilio/voice
PUBLIC_BASE_URL=
# Greeting language (hi-IN, kn-IN, en-IN); it switches to whatever the caller speaks
PHONE_LANG=hi-IN
# "📲 Call me" on the dashboard: Twilio rings this number (E.164, verified on a trial) and TripOwner answers you
# as if you were the driver calling in. Handy because calling a US trial number from India is an international call.
PHONE_TEST_TO=
# stream = live call audio (Sarvam voices, Hindi/Kannada/English); gather = Twilio listens and speaks, English only.
# A Twilio free trial blocks live audio, so use gather on a trial.
PHONE_MODE=stream
# Trial only: calls must come from the trial number Twilio assigned to your verified phone (Console -> Try out Voice)
TWILIO_CALL_FROM=
# Standing permission: book without asking when the fare is within SPEND_CAP_INR
AUTO_BOOK=0

# --- Public demo (hosted for judges) ---
# 1 = never send real email/Telegram/alerts and ignore the personal calendar
PUBLIC_DEMO=0
# Max estimated Nemotron spend per day (USD); 0 = no cap. Over budget, the rule agent takes over.
LLM_DAILY_BUDGET_USD=0

# --- Policy ---
SPEND_CAP_INR=600
MAX_BOOKINGS_PER_TRIP=4
